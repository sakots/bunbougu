{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ぶんぼうぐやさん",
  "version": "0.1.0",
  "identifier": "jp.sakots.bunbougu",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ぶんぼうぐやさん", "width": 960, "height": 700 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
